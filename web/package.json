{
  "name": "proof-of-work-claim",
  "private": true,
  "version": "1.0.0",
  "overrides": {
    "tmp": "0.2.7",
    "ws": "8.21.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "prepare:data": "tsx scripts/prepare.ts",
    "refresh:launch": "tsx scripts/fetch-launch.ts",
    "build": "npm run prepare:data && npm run verify:live && vite build && tsx scripts/inventory.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:interaction": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify:export": "tsx scripts/inventory.ts --check",
    "check:submission": "tsx scripts/check-submission.ts"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "1.0.8",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.103.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.8",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "solc": "0.8.26",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
